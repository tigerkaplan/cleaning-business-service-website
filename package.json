{
  "name": "cleaning-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.cjs",
    "test:placeholders": "node scripts/check-placeholders.cjs",
    "prebuild": "npm run test:placeholders",
    "test:milestone1:env": "node scripts/check-milestone1-env.cjs",
    "test:quote-api": "node scripts/test-quote-api.cjs",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "next": "^16.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
